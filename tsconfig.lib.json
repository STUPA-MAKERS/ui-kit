{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    "paths": {
      "@stupa-makers/ui-kit": ["./src/public-api.ts"],
      "@stupa-makers/ui-kit/markdown-editor": ["./markdown-editor/src/public-api.ts"],
      "@stupa-makers/ui-kit/screens": ["./screens/src/public-api.ts"],
      "@stupa-makers/ui-kit/shell": ["./shell/src/public-api.ts"]
    }
  },
  "exclude": ["**/*.spec.ts", "testing/**", "src/styles/**"],
  "include": [
    "src/**/*.ts",
    "markdown-editor/**/*.ts",
    "markdown-view/**/*.ts",
    "pwa/**/*.ts",
    "shell/**/*.ts",
    "screens/**/*.ts",
    "views/**/*.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
